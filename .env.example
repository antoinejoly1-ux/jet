# Copy to .env.local for local development.

# Postgres. Local default matches docker-compose.yml.
DATABASE_URL=postgresql://jet:jet@localhost:5432/jet

# Better Auth. Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-to-a-32-byte-random-secret
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional locally; the button hides when unset).
# Authorized redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email. Without RESEND_API_KEY, emails are printed to the server console.
RESEND_API_KEY=
EMAIL_FROM="Jet <noreply@example.com>"

# Require two-factor authentication for staff (admin, finance, dispatcher).
# Keep "true" in staging and production.
REQUIRE_STAFF_2FA=false

# Auth rate limiting. Leave "on" everywhere except end-to-end test runs.
AUTH_RATE_LIMIT=on

# File storage. "s3" in staging and production: a private bucket in ca-central-1 (Montreal).
# AWS credentials come from AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY (or the platform's role).
# The bucket needs CORS allowing PUT and GET from the app's origin.
STORAGE_DRIVER=local
S3_BUCKET=
S3_REGION=ca-central-1
LOCAL_STORAGE_DIR=tmp/storage

# Phone number owners see as a "call to book" button on the availability page (optional).
OPERATOR_PHONE=
